# Variable NAMES only. Never put real values in git.
# install.sh copies this to each bot's .env (chmod 600). Keep only the section for that bot.

# ---- Discord-Legacy-Bot ----
DISCORD_TOKEN=
GITHUB_WEBHOOK_SECRET=
# optional
DISCORD_GUILD_ID=
OPENAI_API_KEY=
PORT=3000

# ---- War-Oracle-Bot ----
# DISCORD_TOKEN=            (its own bot token, different from Legacy Bot's)
COC_TOKEN=
CLAN_TAG=
WAR_ALERTS_CHANNEL_ID=
# optional
GUILD_ID=
BOT_COMMANDS_CHANNEL_ID=
WAR_STATUS_CHANNEL_ID=
WAR_STATS_CHANNEL_ID=
POLL_SECONDS=180
ALERT_MINUTES=720,120,30
