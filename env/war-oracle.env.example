# War Oracle .env. Variable NAMES only. Never put real values in git.
# install.sh copies this to /opt/bots/War-Oracle-Bot/.env (chmod 600). Fill the values in by hand on the Pi.
# Plain NAME=value lines: no quotes, no export, no trailing # comments (systemd and dotenv read them differently).

# REQUIRED: this bot's own Discord bot token (a different app and token from Legacy Bot).
# War Oracle needs no privileged intents.
DISCORD_TOKEN=

# Needed for the war features. Clash of Clans API keys are locked to one public IP: make a NEW key for the
# Pi's public IP at https://developer.clashofclans.com (keep the PC's key working until you cut over).
COC_TOKEN=
CLAN_TAG=

# Needed for war alerts
WAR_ALERTS_CHANNEL_ID=

# Optional
# Register slash commands to one server (instant) instead of globally (up to an hour).
GUILD_ID=
BOT_COMMANDS_CHANNEL_ID=
WAR_STATUS_CHANNEL_ID=
WAR_STATS_CHANNEL_ID=
# Seconds between war checks. Must be 30 or more.
POLL_SECONDS=180
ALERT_MINUTES=720,120,30

# Do NOT set DATA_DIR. The service unit is read-only everywhere except <bot dir>/data
# (ProtectSystem=strict, ReadWritePaths). A DATA_DIR elsewhere makes saving fail unless you also add
# that path to ReadWritePaths= in /etc/systemd/system/war-oracle.service.
