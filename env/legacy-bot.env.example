# Legacy Bot .env. Variable NAMES only. Never put real values in git.
# install.sh copies this to /opt/bots/Discord-Legacy-Bot/.env (chmod 600). Fill the values in by hand on the Pi.
# Plain NAME=value lines: no quotes, no export, no trailing # comments (systemd and dotenv read them differently).

# REQUIRED: this bot's own Discord bot token. Developer Portal > Bot > turn ON "Message Content Intent",
# or the bot cannot log in ("Used disallowed intents").
DISCORD_TOKEN=

# Needed only for GitHub push alerts. Without it /github answers 503 (fails closed).
GITHUB_WEBHOOK_SECRET=

# Optional
# Register slash commands to one server (instant) instead of globally (up to an hour).
DISCORD_GUILD_ID=
# Web server port for /healthz and /github (default 3000).
PORT=3000
# Optional GPT commit cleanup. Can cost money; leave empty to use the local formatter.
OPENAI_API_KEY=

# Do NOT set DATA_DIR. The service unit is read-only everywhere except <bot dir>/data
# (ProtectSystem=strict, ReadWritePaths). A DATA_DIR elsewhere makes saving fail unless you also add
# that path to ReadWritePaths= in /etc/systemd/system/legacy-bot.service.
